{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "alexrubl/date-range": "@dev",
        "alexrubl/daterangefilter": "@dev",
        "alexrubl/nova-permission": "@dev",
        "alexrubl/nova-reload-resources": "dev-main",
        "alexrubl/time-range": "@dev",
        "alexrubl/toolbar": "@dev",
        "alexrubl/video": "@dev",
        "digital-creative/icon-action-toolbar": "^0.1.2",
        "formfeed-uk/nova-dependable-panel": "^1.1",
        "ganyicz/nova-callbacks": "^1.1",
        "greg0x46/masked-field": "^1.1",
        "intervention/image": "^3.7",
        "laravel/framework": "^11.9",
        "laravel/nova": "^4.33",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "maatwebsite/laravel-nova-excel": "^1.3",
        "norman-huth/nova-radio-field": "^1.2",
        "outl1ne/nova-settings": "^5.2",
        "pavloniym/nova-action-buttons": "^1.1",
        "simplesquid/nova-advanced-number-field": "^1.0",
        "titasgailius/search-relations": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1",
        "ryoluo/sail-ssl": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "./packages/nova"
        },
        {
            "type": "path",
            "url": "./nova-components/Video"
        },
        {
            "type": "path",
            "url": "./nova-components/DateRange"
        },
        {
            "type": "path",
            "url": "./nova-components/TimeRange"
        },
        {
            "type": "path",
            "url": "./nova-components/Toolbar"
        },
        {
            "type": "path",
            "url": "./nova-components/Daterangefilter"
        },
        {
            "type": "path",
            "url": "./nova-components/IconToolbar"
        },
        {
            "type": "path",
            "url": "./nova-components/icon-action-toolbar",
            "canonical": false
        },
        {
            "type": "path",
            "url": "./nova-components/nova-reload-resources"
        },
        {
            "type": "path",
            "url": "./nova-components/Laravel-Nova-Excel",
            "canonical": false
        },
        {
            "type": "path",
            "url": "./packages/nova-permission",
            "canonical": false
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
